namespace Nono {
  entity Agent;
  entity Session in [Agent];
  entity Caller in [Session];

  entity Command {
    // The command NAME ("git"), a separate wire field. This — never args[0] —
    // is what identifies the command.
    command: String,
    // Exactly what nono sent, nothing normalised away. A Set has no index
    // access, so positional argument matching is unexpressible by construction.
    // Deliberate: nono drops non-UTF-8 argv entries before sending them, so
    // positions are untrustworthy. NOTE args[0] is an absolute PER-RUN shim path
    // (<base>/nono-tool-sandbox-<pid>-<nanos>-<hex>/shims/<command>), so
    // args.contains("git") — or any path literal — can never match it; loading
    // warns about that.
    args: Set<String>,
    // args[1..] joined by a single space; "" when args has fewer than two
    // entries. This is the ONLY sound target for a start-anchored `like` glob,
    // because it omits the per-run args[0]; it mirrors nono's own invocation
    // matcher, argv.iter().skip(1). There is deliberately no whole-argv
    // attribute: an anchored pattern over one could never match at runtime,
    // fail-open in a forbid, so it is unexpressible rather than discouraged.
    // Because args[0] is gone, the FIRST token of argv_tail is the subcommand, so
    // an ANCHORED test — `argv_tail == "status"` or `argv_tail like "status *"` —
    // is the one way to say "the subcommand is `status`", which set membership
    // cannot express (`args.contains("status")` also matches
    // `git -c core.fsmonitor=<cmd> status`, i.e. code execution). Anchored tests
    // are therefore the sound shape for a permit.
    // UNANCHORED GLOBS ARE FORBID-ONLY: a glob that starts with a wildcard also
    // matches text *inside* a single argument — `git commit -m "do not --force
    // this"` matches `argv_tail like "*--force*"` — and it cannot tell
    // ["push --force"] from ["push", "--force"]. Over-matching is fail-safe in a
    // forbid and unsound in a permit, so loading warns about any permit whose
    // argv_tail test is not anchored. For exact per-argument tests use
    // args.contains(..).
    argv_tail: String,
    // Count of the args nono actually sent (post-filter; args[0] included, so a
    // bare `git status` is 2).
    arg_count: Long,
  };

  entity HttpEndpoint {
    route_id: String,
    upstream: String,
    method: String,
    // The RAW request target nono's proxy forwards: not normalised, still
    // percent-encoded, query string included. It is deliberately not normalised
    // here — that would change what a policy matches and would guess at the
    // upstream's own normalisation rules — so a path whose meaning depends on those
    // rules (a `.`/`..` segment at any percent-decode depth, an undecodable escape)
    // is denied before any policy runs rather than handed to one. See
    // src/endpoint_path.rs. A `path like "/repos/*"` glob is therefore safe against
    // traversal, but it still matches the query string: put method and upstream
    // conditions alongside it, not path shape alone.
    path: String,
  };

  action launchCommand appliesTo {
    principal: [Caller],
    resource: [Command],
    context: {
      backend: String,
      intercept_rule: String,
      caller_kind: String,
      reason?: String,
      child_pid: Long,
      session_id: String,
    }
  };

  action httpRequest appliesTo {
    principal: [Caller],
    resource: [HttpEndpoint],
    context: {
      backend: String,
      rule_label: String,
      reason?: String,
    }
  };
}
